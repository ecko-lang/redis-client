# redis - a Redis client (RESP2) written in pure Ecko.
#
# No native code: it frames the wire protocol over std.net's raw sockets
# (connect / connect_tls, send, recv_until, recv_exact) plus the bytes type.
# The entrypoint of the `redis` package; `export` declares its public API.

import std.net

# --- RESP encoding: a command is an array of bulk strings ------------------
# Bulk length is a BYTE count, so a string is framed by its UTF-8 length.

fn arg_bytes(a) = if type_of(a) == "bytes" { a } else { bytes(string(a)) }

## encode(parts) -> the RESP bytes for a command. Public so you can build a
## custom command or inspect the wire format without sending it.
export fn encode(parts) {
    mut out = bytes("*" + string(len(parts)) + "\r\n")
    for p in parts {
        pb = arg_bytes(p)
        out = out + bytes("$" + string(len(pb)) + "\r\n") + pb + bytes("\r\n")
    }
    out
}

# --- RESP decoding: read exactly one reply, recursing for arrays -----------
# recv_until gives the type line (through CRLF); bulk payloads are read with
# recv_exact by their declared length. Bulk values decode as UTF-8 text (the
# common case); a binary-safe variant would return the raw bytes instead.
#
# RESP type bytes: 43 '+' simple string, 58 ':' integer, 45 '-' error,
# 36 '$' bulk string (length-prefixed; -1 = nil), 42 '*' array (-1 = nil).
fn read_reply(sock) {
    line = net.recv_until(sock, b"\r\n")
    kind = line[0]
    body = string(line[1..len(line) - 2])
    match kind {
        43 => body
        58 => int(body)
        45 => error({ kind: "redis", message: body })
        36 => {
            n = int(body)
            if n == -1 { null } else {
                data = net.recv_exact(sock, n + 2)
                string(data[0..n])
            }
        }
        42 => {
            n = int(body)
            if n == -1 { null } else {
                mut items = []
                for i in range(0, n) {
                    items = push(items, read_reply(sock))
                }
                items
            }
        }
        _ => error({ kind: "redis", message: "unknown RESP type: " + string(kind) })
    }
}

# --- the client surface ----------------------------------------------------

## Open a plain TCP connection to a Redis server. Needs the `net` capability.
export fn connect(host, port) = net.connect(host, port)
## Open a TLS connection to a Redis server - use this for anything over a
## network you do not control. Needs the `net` capability.
export fn connect_tls(host, port) = net.connect_tls(host, port)
## Close the connection.
export fn close(sock) = net.close(sock)

## command(sock, parts) -> one decoded reply. Every helper is a wrapper over it,
## and you can call it directly for commands without a helper.
export fn command(sock, parts) {
    net.send(sock, encode(parts))
    read_reply(sock)
}

## Check the server is answering. Returns "PONG".
##
## example:
##   sock = connect("127.0.0.1", 6379)
##   ping(sock)   # "PONG"
export fn ping(sock) = command(sock, ["PING"])
## Store a string value under `key`, replacing anything already there.
export fn set(sock, key, value) = command(sock, ["SET", key, value])
## The value at `key`, or null if nothing is stored there.
export fn get(sock, key) = command(sock, ["GET", key])
## Remove `key`. Returns 1 if it was there, 0 if it was not.
export fn del(sock, key) = command(sock, ["DEL", key])
## Add one to the integer at `key` and return the result. An unset key counts
## as 0, so the first call gives 1.
export fn incr(sock, key) = command(sock, ["INCR", key])
## Subtract one from the integer at `key` and return the result.
export fn decr(sock, key) = command(sock, ["DECR", key])
## 1 if the key is set, 0 if it is not.
export fn exists(sock, key) = command(sock, ["EXISTS", key])
## Give `key` a lifetime in seconds, after which Redis drops it. Returns 1 if
## the key was there to expire.
export fn expire(sock, key, secs) = command(sock, ["EXPIRE", key, secs])
## Seconds left before `key` expires. -1 means it has no expiry set, -2 means
## there is no such key.
export fn ttl(sock, key) = command(sock, ["TTL", key])
## Every key matching a glob pattern. This walks the entire keyspace, so treat
## it as a debugging tool rather than something to call in a request.
export fn keys(sock, pattern) = command(sock, ["KEYS", pattern])
## Prepend a value to the list at `key`. Returns the list's new length.
export fn lpush(sock, key, value) = command(sock, ["LPUSH", key, value])
## Append a value to the list at `key`. Returns the list's new length.
export fn rpush(sock, key, value) = command(sock, ["RPUSH", key, value])
## Items from the list at `key`, between `start` and `stop` inclusive.
## Negative indices count back from the end, so 0 and -1 gets everything.
export fn lrange(sock, key, start, stop) = command(sock, ["LRANGE", key, start, stop])
